<script>
// Atualiza a action do formulário quando um usuário é selecionado
document.getElementById('participant_id').addEventListener('change', function() {
    const participantId = this.value;
    const eventId = <?= $event->id ?>;
    const form = document.getElementById('addParticipantForm');

    if (participantId) {
        form.action = `/events/${eventId}/participants/${participantId}/add`;
    }
});
</script>
