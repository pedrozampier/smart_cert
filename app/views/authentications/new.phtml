<style>
    .form-input {
        background-color: rgba(255, 255, 255, 0.1);
        border-color: rgba(255, 255, 255, 0.2);
        color: white;
    }
    .form-input::placeholder {
        color: rgba(255, 255, 255, 0.5);
    }
</style>

<div class="min-h-screen flex flex-col items-center justify-center px-4">
    <div class="-mb-[80px]">
        <img
            src="/assets/images/logo.png"
            alt="SmartCert Logo"
            class="h-80 w-auto">
    </div>

    <div class="w-full max-w-md p-8">

        <form class="space-y-6" action="/login" method="POST">
            <div>
                <label for="user_email" class="block text-sm font-medium text-white mb-2">Email</label>
                <input
                    type="email"
                    id="user_email"
                    name="user[email]"
                    required
                    class="w-full px-4 py-3 rounded-md focus:outline-none focus:ring-1 focus:ring-blue-500 form-input"
                    placeholder="seu@email.com">
            </div>

            <div>
                <label for="user_password" class="block text-sm font-medium text-white mb-2">Senha</label>
                <input
                    type="password"
                    id="user_password"
                    name="user[password]"
                    required
                    class="w-full px-4 py-3 rounded-md focus:outline-none focus:ring-1 focus:ring-blue-500 form-input"
                    placeholder="••••••••">
            </div>

            <button
                type="submit"
                class="w-full py-3 px-4 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-md transition-colors">
                Enter
            </button>
        </form>
    </div>
</div>
